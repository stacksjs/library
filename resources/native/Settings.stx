<script client>
import { apiOrigin, keychainSession, nativeApi, nativeCraft, openWeb, saveAccount, savedAccount, updater, updaterStatus } from '../functions/notes/native-app'

const session = keychainSession()
const api = nativeApi(session)
const account = state(savedAccount())
const signedIn = state(!!session.token())
const scheme = state(nativeCraft().appearance.colorScheme())
const note = state('')
const busy = state(false)
const confirmEmail = state('')
const canDelete = derived(() => !busy() && !!account()?.email && confirmEmail().trim().toLowerCase() === String(account()?.email).toLowerCase())
const version = nativeCraft().app.version || ''
const pane = state('account')
// What the updater says: checking, an update to install, one waiting for a restart, or why this copy does not update itself.
const update = state(updaterStatus())

async function load() {
  if (!session.token()) return
  try {
    const me = await api.me()
    account.set(me)
    saveAccount(me)
    note.set('')
  }
  catch (error) { note.set(error?.status ? (error.message || 'Could not load your account.') : 'Offline. Showing the account saved on this Mac.') }
}

async function signOut() {
  busy.set(true)
  try { await api.signOut() }
  catch { session.save(null) }
  finally {
    busy.set(false)
    saveAccount(null)
    account.set(null)
    signedIn.set(false)
    note.set('Signed out. Sign in again from the main window.')
  }
}

async function deleteAccount() {
  busy.set(true)
  try {
    await api.deleteAccount(confirmEmail().trim())
    session.save(null)
    saveAccount(null)
    account.set(null)
    signedIn.set(false)
    confirmEmail.set('')
    note.set('Your account and everything in it were deleted.')
  }
  catch (error) { note.set(error?.message || 'Could not delete your account. Try again.') }
  finally { busy.set(false) }
}

async function checkForUpdates() { update.set(await updater().check()) }
async function installUpdate() { update.set(await updater().install()) }
function restartToUpdate() { updater().relaunch().catch(error => note.set(error?.message || 'Could not restart. Quit Notes and open it again.')) }

onMount(async () => {
  onDestroy(nativeCraft().session.onChange((token) => {
    session.adopt(token)
    signedIn.set(!!token)
    if (token) load()
    else account.set(null)
  }))
  onDestroy(nativeCraft().desktop.onCommand((id) => {
    if (id === 'appearance') scheme.set(nativeCraft().appearance.colorScheme())
  }))
  onDestroy(updater().onChange(next => update.set(next)))
  update.set(await updater().status())
  await load()
})
</script>

<SettingsWindow id="settings" title="Settings" storageKey="notes" v-model:pane="pane" testID="settings">
  <template #account>
    <View class="flex-row gap-[8px] items-center px-[8px] py-[4px]" testID="settings-account-card">
      <Icon symbol="person.crop.circle.fill" class="h-[34px] w-[34px]" style="color: secondaryLabel" />
      <View class="flex-1 flex-col min-w-0">
        <Text class="font-semibold text-[13px]" :numberOfLines="1" :text="signedIn() && account() ? (account()?.name || 'Signed in') : 'Not signed in'" testID="settings-name" />
        <Text class="text-[11px]" style="color: secondaryLabel" :numberOfLines="1" :text="signedIn() && account() ? (account()?.email || '') : 'Sign in from the main window'" testID="settings-email" />
      </View>
    </View>
  </template>

  <template #sidebar>
    <SettingsSidebarGroup>
      <SettingsSidebarItem id="account" label="Account" symbol="person.crop.circle.fill" tone="blue" keywords="sign out email delete" />
      <SettingsSidebarItem id="general" label="General" symbol="gearshape.fill" tone="grey" keywords="appearance dark light server offline" />
    </SettingsSidebarGroup>
    <SettingsSidebarGroup>
      <SettingsSidebarItem id="updates" label="Software Update" symbol="arrow.down.circle.fill" tone="green" keywords="version upgrade release" />
      <SettingsSidebarItem id="about" label="About" symbol="info.circle.fill" tone="grey" keywords="version privacy support" />
    </SettingsSidebarGroup>
  </template>

  <SettingsPane id="account" title="Account" active>
    <SettingsGroup :if="signedIn() && account()" footer="Your sign-in is kept in the macOS Keychain. The website and this app use the same account.">
      <SettingsRow label="Name" setting="name"><Text class="text-[13px]" style="color: secondaryLabel" :text="account()?.name || ''" /></SettingsRow>
      <SettingsRow label="Email" setting="email"><Text class="text-[13px]" style="color: secondaryLabel" :text="account()?.email || ''" /></SettingsRow>
      <SettingsRow label="Sign out of this Mac" setting="sign-out" keywords="log out">
        <Button appearance="mac" title="Sign Out" :disabled="busy()" testID="settings-sign-out" @click="signOut()" />
      </SettingsRow>
    </SettingsGroup>
    <SettingsGroup :if="!signedIn() || !account()">
      <SettingsRow label="Not signed in" description="Use the main window to sign in or create an account." setting="signed-out" multiline testID="settings-signed-out" />
    </SettingsGroup>
    <SettingsGroup :if="signedIn() && account()" header="Delete Account" footer="Permanently deletes your account, to-dos, notes and prompt libraries from the server. This cannot be undone.">
      <SettingsRow label="Type your email address to confirm" layout="stacked" setting="delete-account" keywords="remove erase">
        <View class="flex-row gap-[8px] items-center">
          <View class="flex-1"><TextInput variant="mac" x-model="confirmEmail" placeholder="Your email address" testID="settings-delete-email" /></View>
          <Button appearance="mac" variant="danger" title="Delete Account" :disabled="!canDelete()" testID="settings-delete" @click="deleteAccount()" />
        </View>
      </SettingsRow>
    </SettingsGroup>
    <Text :if="note()" class="px-[10px] text-[12px]" style="color: secondaryLabel" :text="note()" testID="settings-note" />
  </SettingsPane>

  <SettingsPane id="general" title="General">
    <SettingsGroup header="Appearance" footer="Notes follows your Mac. Change it in System Settings, Appearance.">
      <SettingsRow label="Appearance" setting="appearance" keywords="dark light theme">
        <Text class="text-[13px]" style="color: secondaryLabel" :text="scheme() === 'dark' ? 'Dark' : 'Light'" testID="settings-appearance" />
      </SettingsRow>
    </SettingsGroup>
    <SettingsGroup header="Sync" footer="Lists and notes you have opened stay readable when you are offline, and changes are sent when you are back.">
      <SettingsRow label="Server" setting="server" keywords="sync api">
        <Text class="text-[13px]" style="color: secondaryLabel" :numberOfLines="1" :text="apiOrigin() || 'Not set'" testID="settings-origin" />
      </SettingsRow>
    </SettingsGroup>
  </SettingsPane>

  <SettingsPane id="updates" title="Software Update">
    <SettingsGroup :footer="update()?.selfUpdating === false ? (update()?.reason || 'This copy of Notes is updated by the store it came from.') : 'Notes checks for updates when it opens and once a day. An update is verified before it is installed.'">
      <SettingsUpdateRow appName="Notes" :status="update()" @check="checkForUpdates()" @install="installUpdate()" @relaunch="restartToUpdate()" />
    </SettingsGroup>
    <SettingsGroup :if="update()?.notes" header="What is New">
      <SettingsRow :label="'Version ' + (update()?.version || '')" :description="update()?.notes || ''" setting="release-notes" multiline />
    </SettingsGroup>
  </SettingsPane>

  <SettingsPane id="about" title="About">
    <SettingsPaneHeader symbol="note.text" tone="blue" title="Notes" description="Notes, to-dos and the prompts you reuse, in one calm place." />
    <SettingsGroup>
      <SettingsRow label="Version" setting="version"><Text class="text-[13px]" style="color: secondaryLabel" :text="version || 'Development build'" testID="settings-version" /></SettingsRow>
    </SettingsGroup>
    <SettingsGroup>
      <SettingsRow label="Privacy Policy" setting="privacy">
        <Button appearance="mac" title="Open" testID="settings-privacy" @click="openWeb(apiOrigin() + '/privacy')" />
      </SettingsRow>
      <SettingsRow label="Support" setting="support">
        <Button appearance="mac" title="Open" testID="settings-support" @click="openWeb(apiOrigin() + '/support')" />
      </SettingsRow>
    </SettingsGroup>
  </SettingsPane>
</SettingsWindow>
